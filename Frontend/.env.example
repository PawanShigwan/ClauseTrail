# .env.example – Frontend environment variables template
#
# Copy this file to .env.local for local development (already in .gitignore).
# In Vercel, add these variables via the Vercel dashboard → Project → Settings → Environment Variables.
#
# ─────────────────────────────────────────────────────────────────────────────
# VITE_API_URL
#   The fully-qualified base URL of your deployed Render backend.
#   Do NOT add a trailing slash.
#   Leave this variable UNSET for local development – the Vite dev server
#   proxy defined in vite.config.ts will route /api requests to localhost:8080.
#
#   Example (production on Render):
VITE_API_URL=https://clausetrail-backend.onrender.com
